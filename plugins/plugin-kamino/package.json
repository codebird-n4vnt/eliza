{
  "name": "@elizaos/plugin-kamino",
  "description": "Kamino Finance lending and borrowing plugin for elizaOS — lend, borrow, deposit collateral, repay, and query live market rates on Solana.",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageType": "plugin",
  "platform": "node",
  "license": "MIT",
  "keywords": [
    "plugin",
    "elizaos",
    "solana",
    "kamino",
    "defi",
    "lending",
    "borrowing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/elizaOS/eliza"
  },
  "homepage": "https://elizaos.ai",
  "bugs": {
    "url": "https://github.com/elizaOS/eliza/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CLAUDE.md",
    "AGENTS.md",
    ".env.example",
    "package.json"
  ],
  "dependencies": {
    "@kamino-finance/farms-sdk": "^3.2.26",
    "@kamino-finance/klend-sdk": "^9.0.1",
    "@kamino-finance/kliquidity-sdk": "^13.0.0",
    "@kamino-finance/limo-sdk": "^2.0.4",
    "@solana/kit": "^3.0.3",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.3",
    "bs58": "^6.0.0",
    "decimal.js": "^10.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@elizaos/core": "workspace:*",
    "@types/bn.js": "^5.1.6",
    "@types/node": "^25.0.3",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "start": "elizaos start",
    "dev": "elizaos dev",
    "build": "bun run build.ts",
    "build:watch": "bun run build.ts --watch",
    "test": "bun test"
  },
  "publishConfig": {
    "access": "public"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "SOLANA_RPC_URL": {
        "type": "string",
        "description": "Solana RPC endpoint URL"
      },
      "SOLANA_PRIVATE_KEY": {
        "type": "string",
        "description": "Base58-encoded private key of the signing wallet"
      }
    }
  }
}